---
import BudouxText from './BudouxText.astro';
import Icon from '../theme/navfolio/components/Icon.astro';
import { achievements } from '../data/interests';
---
<section id="achievements" class="achievements-card">
  <h2 class="card-heading"><Icon name="star" /> Activities</h2>
  <ol>{achievements.map(achievement => <li>
    <p class="eyebrow">{achievement.label}</p>
    <h3><BudouxText text={achievement.title} /></h3>
    <p class="achievement-status"><BudouxText text={achievement.description} /></p>
  </li>)}</ol>
</section>
