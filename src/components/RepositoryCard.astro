---
import Icon from '../theme/navfolio/components/Icon.astro';
interface Props {
  repositoryUrl: string;
  class?: string;
}
const { repositoryUrl, class: className = 'mt-12' } = Astro.props;
const url = new URL(repositoryUrl);
const [owner, name] = url.pathname.split('/').filter(Boolean);
const label = url.hostname === 'github.com' && owner && name ? `${owner}/${name}` : url.hostname;
---
<a class:list={['repository-card', className]} href={url.toString()} target="_blank" rel="noopener noreferrer" aria-label={`${label}のリポジトリを開く（新しいタブ）`}>
  <Icon name="github" size={26} />
  <span><small>REPOSITORY</small><strong>{label}</strong></span>
  <Icon name="external" size={18} />
</a>
<style>
  .repository-card { display: grid; grid-template-columns: 26px minmax(0, 1fr) 18px; align-items: center; gap: 18px; max-width: 42rem; padding: 22px; border: 1px solid var(--paper-line); border-radius: 8px; background: var(--paper-surface-muted); color: var(--paper-accent); text-decoration: none; }
  .repository-card:hover { border-color: var(--paper-accent); }
  small { display: block; color: var(--paper-ink-soft); font-size: .65rem; letter-spacing: .08em; }
  strong { display: block; color: var(--paper-ink); font-size: .9rem; overflow-wrap: anywhere; }
</style>
