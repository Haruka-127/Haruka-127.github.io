---
import BudouxText from './BudouxText.astro';
import { interests } from '../data/interests';
---
<section id="interests" class="interests-card">
  <h2 class="card-heading">Interests</h2>
  <div class="interest-list">{interests.map(interest => <article>
    <h3>{interest.title}</h3>
    <p><BudouxText text={interest.description} /></p>
    <ul class="interest-tags" aria-label={`${interest.title}のキーワード`}>{interest.keywords.map(keyword => <li>{keyword}</li>)}</ul>
  </article>)}</div>
</section>
