---
import { profile } from '../data/profile';
import { navigation } from '../data/navigation';
import Icon from '../theme/navfolio/components/Icon.astro';
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => href === '/'
  ? currentPath === '/'
  : currentPath === href.replace(/\/$/, '') || currentPath.startsWith(href);
---
<header class="blog-top-nav">
  <a class="brand" href="/" aria-label="Haruka ホーム"><span class="brand-mark" aria-hidden="true"></span>{profile.brand}</a>
  <nav class="nav-links" aria-label="メインナビゲーション">{navigation.map(link => <a class="nav-link" href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>{link.label}</a>)}</nav>
  <a class="github-link" href={profile.githubUrl} aria-label="HarukaのGitHub（新しいタブ）" target="_blank" rel="noopener noreferrer"><Icon name="github" /></a>
</header>
