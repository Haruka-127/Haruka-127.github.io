---
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProjectContent from '../../components/ProjectContent.astro';
import RepositoryCard from '../../components/RepositoryCard.astro';
import BudouxText from '../../components/BudouxText.astro';
import { profile } from '../../data/profile';
import { projects, type Project } from '../../data/projects';

export const getStaticPaths = (() => projects.map((project) => ({
  params: { slug: project.slug },
  props: { project },
}))) satisfies GetStaticPaths;

interface Props { project: Project }
const { project } = Astro.props;
---
<Layout title={`${project.title} | ${profile.handle}`} description={project.summary}>
  <Header />
  <main id="main-content" class="container-shell detail-page">
    <a class="detail-back" href="/projects/">← Projectsへ戻る</a>
    <p class="eyebrow">PROJECT / {project.slug}</p>
    <h1 class="mt-3 max-w-3xl text-[clamp(2.25rem,8vw,5rem)] font-bold leading-tight tracking-[-0.055em] text-black">
      {project.titleParts.map((part, index) => (
        <>{index > 0 && <wbr />}<span class="detail-title-part">{part}</span></>
      ))}
    </h1>
    <p class="mt-10 max-w-2xl whitespace-pre-line text-base leading-8 text-slate-700"><BudouxText text={project.summary} /></p>
    {project.content ? (
      <ProjectContent sections={project.content} />
    ) : (
      <div class="mt-12 border-t border-slate-200 pt-10">
        <p class="max-w-2xl whitespace-pre-line text-base leading-8 text-slate-700"><BudouxText text={project.body} /></p>
      </div>
    )}
    {project.repositoryUrl && <RepositoryCard repositoryUrl={project.repositoryUrl} />}
    <a class="mt-16 inline-block text-sm text-black underline underline-offset-4 hover:no-underline" href="/projects/">← Projectsへ戻る</a>
  </main>
  <Footer />
</Layout>
