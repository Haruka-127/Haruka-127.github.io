---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Interests from '../components/Interests.astro';
import Achievements from '../components/Achievements.astro';
import Contact from '../components/Contact.astro';
import IntroCard from '../theme/navfolio/components/cards/IntroCard.astro';
import ProfileCard from '../theme/navfolio/components/cards/ProfileCard.astro';
import DoingCard from '../theme/navfolio/components/widgets/DoingCard.astro';
import DashboardFlow from '../theme/navfolio/components/layout/DashboardFlow.astro';
import { home } from '../data/navigation';
---
<Layout>
  <Header />
  <div class="publication-bg" aria-hidden="true"></div>
  <DashboardFlow>
    <ProfileCard slot="profile" profile={home.profile} />
    <IntroCard slot="intro" intro={home.intro} quote={home.quote} />
    <DoingCard slot="doing" items={home.doing} />
    <Interests slot="interests" />
    <Achievements slot="achievements" />
    <Contact slot="connect" />
  </DashboardFlow>
  <Footer />
</Layout>
